{
  "name": "NodePulse",
  "version": "1.18.0",
  "slug": "nodepulse",
  "description": "Comprehensive dashboard and integration for monitoring Meshtastic networks directly within Home Assistant",
  "url": "https://github.com/garethmo/NodePulse",
  "arch": [
    "aarch64",
    "amd64",
    "armhf",
    "armv7",
    "i386"
  ],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "ingress": true,
  "ingress_port": 8099,
  "ports": {
    "8099/tcp": 8099
  },
  "panel_icon": "mdi:radio-tower",
  "panel_title": "NodePulse",
  "options": {
    "log_level": "info",
    "connection_type": "direct",
    "meshtastic_host": "192.168.1.100",
    "meshtastic_port": 4403,
    "proxy_host": "",
    "proxy_port": 4403,
    "access_key": "",
    "scan_interval": 30,
    "ignored_nodes": [],
    "ha_base_url": "http://homeassistant:8123",
    "disable_token_validation": true,
    "mqtt_enabled": false,
    "mqtt_address": "mqtt.meshtastic.org",
    "mqtt_port": 1883,
    "mqtt_username": "meshdev",
    "mqtt_password": "large4cats",
    "mqtt_topic": "msh/+",
    "mqtt_geo_filter_enabled": false,
    "mqtt_lat_min": 0.0,
    "mqtt_lat_max": 0.0,
    "mqtt_lng_min": 0.0,
    "mqtt_lng_max": 0.0,
    "mqtt_portnum_allowlist": [],
    "mqtt_node_blocklist": [],
    "mqtt_forwarding_enabled": false,
    "telegram_enabled": false,
    "telegram_bot_token": "",
    "telegram_chat_id": "",
    "telegram_authorized_chat_ids": [],
    "telegram_forward_channels": "0",
    "telegram_forward_dms": true,
    "telegram_allow_commands": true,
    "auto_responder_enabled": false,
    "auto_responder_message": "Welcome to the mesh! You have been discovered by NodePulse.",
    "auto_traceroute_enabled": false,
    "scheduled_messages_enabled": true
  },
  "schema": {
    "log_level": "list(trace|debug|info|notice|warning|error|fatal)",
    "connection_type": "list(direct|proxy)",
    "meshtastic_host": "str",
    "meshtastic_port": "port",
    "proxy_host": "str?",
    "proxy_port": "port",
    "access_key": "str?",
    "scan_interval": "int(10,300)",
    "ignored_nodes": [
      "str?"
    ],
    "ha_base_url": "str?",
    "disable_token_validation": "bool?",
    "mqtt_enabled": "bool?",
    "mqtt_address": "str?",
    "mqtt_port": "port?",
    "mqtt_username": "str?",
    "mqtt_password": "str?",
    "mqtt_topic": "str?",
    "mqtt_geo_filter_enabled": "bool?",
