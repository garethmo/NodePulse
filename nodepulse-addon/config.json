    "mqtt_lat_max": "float?",
    "mqtt_lng_min": "float?",
    "mqtt_lng_max": "float?",
    "mqtt_portnum_allowlist": [
      "str?"
    ],
    "mqtt_node_blocklist": [
      "str?"
    ],
    "mqtt_forwarding_enabled": "bool?",
    "telegram_enabled": "bool?",
    "telegram_bot_token": "str?",
    "telegram_chat_id": "str?",
    "telegram_authorized_chat_ids": [
      "str?"
    ],
    "telegram_forward_channels": "str",
    "telegram_forward_dms": "bool?",
